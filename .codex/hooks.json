{
  "description": "Read-only LoanSim phase reminder at session start.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.py\"",
            "commandWindows": "py -3 -c \"import pathlib,runpy,subprocess; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); runpy.run_path(str(pathlib.Path(root)/'.codex'/'hooks'/'session_start.py'),run_name='__main__')\"",
            "timeout": 3,
            "additionalContextLimit": 1000,
            "statusMessage": "Reading LoanSim phase status"
          }
        ]
      }
    ]
  }
}
